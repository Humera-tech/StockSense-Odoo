DATABASE_URL=postgresql+psycopg2://stocksense:stocksense@localhost:5432/stocksense
# SQLite fallback if Docker is unavailable:
# DATABASE_URL=sqlite:///./stocksense.db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Frontend origins allowed to call this API. Comma-separated, no spaces needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://stocksense-frontend-bcik.onrender.com
# Offline demo: return the password-reset code in the API response (no mail server).
SHOW_DEV_OTP=true
